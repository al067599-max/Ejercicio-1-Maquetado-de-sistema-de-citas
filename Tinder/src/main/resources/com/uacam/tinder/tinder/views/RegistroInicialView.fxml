<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uacam.tinder.tinder.controladores.RegistroControlador"
      alignment="CENTER" spacing="15" styleClass="main-container">

    <Label text="Registrate" styleClass="title-label"/>

    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Edad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Spinner fx:id="spEdad" editable="true" prefWidth="90" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label text="Código Postal:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Género:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cbGenero" promptText="Selecciona..." GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <HBox spacing="10" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
        <ImageView fx:id="imgPreview" fitWidth="60" fitHeight="60" preserveRatio="true"/>
        <Button text="Seleccionar foto..." onAction="#onSeleccionarFoto"/>
        <Label fx:id="lblFotoSeleccionada" text="Ningún archivo seleccionado"/>
        </HBox>
    </GridPane>

    <Button text="Continuar a Búsqueda" onAction="#onContinuar" styleClass="primary-button"/>
</VBox>