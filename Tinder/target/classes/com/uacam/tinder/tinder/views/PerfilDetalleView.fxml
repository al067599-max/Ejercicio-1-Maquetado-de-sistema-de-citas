<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.uacam.tinder.tinder.controladores.DetallePerfilControlador"
      alignment="CENTER" spacing="15" styleClass="main-container">

    <Label text="Perfil de: Maria Jose" styleClass="title-label"/>
    <Label text="Ubicación: CP 12345 | Intereses: Actuación, Modelaje, Fotografía"/>

    <Separator prefWidth="400"/>

    <Label text="Formulario de Solicitud de Contacto" styleClass="subtitle-label"/>

    <HBox alignment="CENTER" spacing="10">
        <Label text="Medio preferido de contacto:"/>
        <ComboBox promptText="Seleccionar..."/>
    </HBox>

    <TextArea promptText="Escribe un mensaje para presentarte..." prefHeight="100" prefWidth="400"/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Enviar Solicitud" onAction="#onEnviar" styleClass="primary-button"/>
        <Button text="Volver" onAction="#onVolver"/>
    </HBox>
</VBox>